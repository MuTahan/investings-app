# ---- App ----
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# ---- Database (async SQLAlchemy URL) ----
# For docker-compose this is overridden to the `db` service host.
DATABASE_URL=postgresql+asyncpg://investing:investing@localhost:5432/investing

# ---- Cache (optional; leave blank to use in-memory cache) ----
REDIS_URL=

# ---- Auth / Security ----
# Generate a strong secret in production, e.g. `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_DEV_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Apple Sign-In (the iOS app's bundle/service id used as the token audience)
APPLE_CLIENT_ID=
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_ISSUER=https://appleid.apple.com

# ---- Market data providers (free tiers) ----
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
NEWSAPI_API_KEY=

# ---- AI providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DECISION_MODE=empowered
AI_AGENT_MODEL=claude-haiku-4-5
AI_CHAIR_MODEL=claude-sonnet-4-6

# ---- Notifications (channels fan out; enable either/both/neither) ----
# ntfy: pick any hard-to-guess topic, subscribe to it in the ntfy app/browser.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Telegram: create a bot via @BotFather, get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Web app URL used for deep-links inside notifications.
APP_BASE_URL=http://localhost:5173

# ---- Scheduler ----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
# Only notify at/above this priority: normal | high | critical
NOTIFY_MIN_PRIORITY=high
NOTIFY_MAX_PER_RUN=10
# Optional quiet hours (UTC, 0-23); leave blank to disable.
QUIET_HOURS_START=
QUIET_HOURS_END=
