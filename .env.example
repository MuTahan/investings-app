# Root env for `docker compose` (auto-loaded). Copy to `.env` and fill in.
# `.env` is gitignored — never commit real keys.

# Strong secret for signing JWTs (generate: openssl rand -hex 32)
JWT_SECRET=change-me

# Public URL of the web app (used for deep-links in notifications)
# Local: http://localhost:8080   Prod: https://app.yourdomain.com
APP_BASE_URL=http://localhost:8080

# Set false (and redeploy) after creating your account on a public deployment.
REGISTRATION_ENABLED=true

# ---- Production only (docker-compose.prod.yml) ----
# Domain with an A record pointing at your VPS — Caddy issues HTTPS for it.
DOMAIN=app.yourdomain.com
# Change the database password for production.
POSTGRES_PASSWORD=change-me-too

# ---- Market data (at least one enables live quotes/charts/news) ----
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=      # free tier (800/day) — enables intraday 1D/3D/1W charts
NEWSAPI_API_KEY=

# ---- AI committee ----
# Pick a backend: LLM_PROVIDER = auto | anthropic | openai | google | stub.
# For Google Gemini (AI Studio key): set GOOGLE_API_KEY, LLM_PROVIDER=google,
# AI_AGENT_MODEL=AI_CHAIR_MODEL=gemini-2.5-flash.
# Modes: deterministic (no LLM) | chair_assisted (LLM judges as Chair only, 1 call/rec —
# best for free tiers) | empowered (all 6 agents + Chair use the LLM, 7 calls/rec).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=auto
# Conversational stock chat (Grok / xAI). Get a key at console.x.ai.
XAI_API_KEY=
AI_DECISION_MODE=deterministic
AI_AGENT_MODEL=gemini-2.5-flash
AI_CHAIR_MODEL=gemini-2.5-flash

# ---- Notifications (optional) ----
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
