# Root env for `docker compose` (auto-loaded). Copy to `.env` and fill in.
# `.env` is gitignored — never commit real keys.

# Strong secret for signing JWTs (generate: openssl rand -hex 32)
JWT_SECRET=change-me

# Public URL of the web app (used for deep-links in notifications)
APP_BASE_URL=http://localhost:8080

# ---- Market data (at least one enables live quotes/charts/news) ----
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWSAPI_API_KEY=

# ---- AI (set ANTHROPIC_API_KEY + AI_DECISION_MODE=empowered for Claude) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DECISION_MODE=deterministic

# ---- Notifications (optional) ----
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
